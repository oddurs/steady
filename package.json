{
  "name": "@oddurs/steady",
  "version": "0.2.0",
  "description": "Durable interaction primitives. Immediate intent, honest feedback, predictable recovery.",
  "type": "module",
  "license": "MIT",
  "author": "Oddur Sigurdsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddurs/steady.git"
  },
  "homepage": "https://github.com/oddurs/steady#readme",
  "bugs": {
    "url": "https://github.com/oddurs/steady/issues"
  },
  "keywords": [
    "ux",
    "optimistic",
    "react",
    "navigation",
    "headless",
    "typescript",
    "async"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup",
    "dev": "vite playground --host 127.0.0.1",
    "build:playground": "vite build playground",
    "preview": "vite preview playground --host 127.0.0.1",
    "site:sync": "node scripts/sync-site.mjs",
    "site:dev": "npm run site:sync && npm --prefix site run dev",
    "site:check": "npm run site:sync && npm --prefix site run check",
    "site:build": "npm run site:sync && npm --prefix site run build",
    "site:test": "playwright test --config playwright.site.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run build:playground",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
